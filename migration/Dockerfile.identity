FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY migration ./migration
COPY identity-requirements.lock ./identity-requirements.lock
RUN pip install --constraint identity-requirements.lock '.[identity-all]' \
    && groupadd --system --gid 10001 identity \
    && useradd --system --uid 10001 --gid identity --home-dir /work identity \
    && mkdir /work && chown identity:identity /work
USER 10001:10001
WORKDIR /work
ENTRYPOINT ["python", "-m", "migration.identity"]
CMD ["--help"]
