{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$"
    },
    "object_key": {
      "type": "string"
    },
    "local_relative_path": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "enum": [
        "local_only",
        "remote_compared"
      ]
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "archive_fidelity": {
      "enum": [
        "source_file",
        "api_records"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "object_key",
    "local_relative_path",
    "bytes",
    "sha256",
    "archived_at",
    "verification"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External original archive manifest v1"
}
