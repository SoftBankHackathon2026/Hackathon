{
  "name": "oneport-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:connections": "vite --host 127.0.0.1 --port 4320 --open '/?connection-preview=1#prepare'",
    "test:browser": "playwright test",
    "test": "node --test tests/*.test.ts",
    "dev": "vite --host 127.0.0.1 --port 4320",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "@tanstack/react-query": "^5.106.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
