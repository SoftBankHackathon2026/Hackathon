{
  "mode": "live",
  "environments": [
    {
      "id": "onprem",
      "name": "온프렘 k3s (서울)",
      "kind": "k3s",
      "provider": "onprem",
      "region": "seoul-local",
      "role": "legacy",
      "kubeconfig": "/etc/oneport/kube/onprem.kubeconfig",
      "context": "hackathon",
      "app_namespace": "hackathon",
      "argocd_namespace": "argocd",
      "boundary": ["사이트 seoul-local"],
      "data_services": [
        {"kind": "postgres", "name": "postgres (PostgreSQL 16)", "managed": false},
        {"kind": "kafka", "name": "kafka (KRaft 3.9.1)", "managed": false},
        {"kind": "object_storage", "name": "SeaweedFS (S3 호환)", "managed": false},
        {"kind": "vector_db", "name": "qdrant", "managed": false}
      ],
      "declared": {
        "threat_detection": false, "posture_service": false, "db_tls_required": true,
        "db_public": false, "db_backups": true, "workload_identity": false,
        "ingress_tls": false, "waf": false, "policy_gates": true
      }
    },
    {
      "id": "aws",
      "name": "AWS EKS oneaction (서울)",
      "kind": "eks",
      "provider": "aws",
      "region": "ap-northeast-2",
      "role": "target",
      "in_cluster": true,
      "app_namespace": "platform",
      "argocd_namespace": "argocd",
      "boundary": ["AWS 계정 t3underline", "리전 ap-northeast-2"],
      "data_services": [
        {"kind": "postgres", "name": "RDS oneaction-review-db", "managed": true},
        {"kind": "kafka", "name": "MSK oneaction-review", "managed": true},
        {"kind": "object_storage", "name": "S3 oneaction-review-docs", "managed": true}
      ],
      "declared": {
        "threat_detection": false, "posture_service": false, "audit_log": true, "flow_logs": true,
        "db_tls_required": true, "db_public": false, "db_encrypted_at_rest": true,
        "db_backups": true, "workload_identity": true, "ingress_tls": false, "waf": false,
        "policy_gates": true
      },
      "cloud_scope": {"cluster": "oneaction", "databases": ["oneaction-review-db"]}
    },
    {
      "id": "gcp",
      "name": "GCP GKE oneaction-dev (서울)",
      "kind": "gke",
      "provider": "gcp",
      "region": "asia-northeast3",
      "role": "target",
      "kubeconfig": "/etc/oneport/kube/gcp.kubeconfig",
      "context": "oneaction-gke",
      "app_namespace": "platform",
      "argocd_namespace": "argocd",
      "boundary": ["GCP 프로젝트 ghost-project", "리전 asia-northeast3"],
      "data_services": [
        {"kind": "postgres", "name": "Cloud SQL oneaction-dev-review", "managed": true},
        {"kind": "kafka", "name": "Managed Kafka oneaction-dev-review", "managed": true},
        {"kind": "object_storage", "name": "Cloud Storage oneaction-dev-review", "managed": true}
      ],
      "declared": {
        "threat_detection": false, "posture_service": false, "audit_log": true, "flow_logs": true,
        "db_tls_required": true, "db_public": false, "db_encrypted_at_rest": true,
        "db_backups": true, "workload_identity": true, "ingress_tls": false, "waf": false,
        "policy_gates": true
      },
      "cloud_scope": {
        "cluster": "oneaction-dev",
        "cluster_location": "asia-northeast3",
        "project": "ghost-project-513812",
        "databases": ["oneaction-dev-review"]
      }
    }
  ],
  "migrations": [],
  "task_defaults": {
    "connect_url": "${ONEPORT_ONPREM_CONNECT_URL}"
  },
  "sample_seconds": 5
}
