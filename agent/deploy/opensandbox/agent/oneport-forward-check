#!/usr/bin/env python3
"""멈춘 port-forward 를 다시 띄운다.

kubectl port-forward 는 연결이 끊겨도 프로세스가 살아 있어 systemd 가 모른다. 그동안 새 연결마다 Timeout 이 나고
에이전트는 정책 판정을 못 받아 사람에게 넘기기를 반복한다. 로컬 포트에 실제로 말을 걸어 보고, 두 번 연속 답이 없으면
해당 forward 만 재시작한다.
"""

import socket
import subprocess
import sys
from pathlib import Path

FORWARDS = Path("/etc/oneport-agent/forwards")
STATE = Path("/run/oneport-forward-check")
TIMEOUT = 5.0
FAILS_BEFORE_RESTART = 2
SSL_REQUEST = bytes.fromhex("0000000804d2162f")


def answers(name: str, port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=TIMEOUT) as conn:
            conn.settimeout(TIMEOUT)
            if name == "postgres":
                conn.sendall(SSL_REQUEST)
                return conn.recv(1) in (b"S", b"N")
            conn.sendall(b"GET / HTTP/1.0\r\nHost: localhost\r\n\r\n")
            return conn.recv(5) == b"HTTP/"
    except OSError:
        return False


def main() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    for line in FORWARDS.read_text().splitlines():
        if not line.strip():
            continue
        name, ports = line.split()
        port = int(ports.split(":")[0])
        counter = STATE / name
        if answers(name, port):
            counter.unlink(missing_ok=True)
            continue
        fails = int(counter.read_text() or 0) + 1 if counter.exists() else 1
        if fails < FAILS_BEFORE_RESTART:
            counter.write_text(str(fails))
            print(f"{name}: 127.0.0.1:{port} 응답 없음 ({fails}번째)", flush=True)
            continue
        counter.unlink(missing_ok=True)
        print(f"{name}: {fails}번 연속 응답 없음. oneport-forward@{name} 을 다시 띄운다", flush=True)
        subprocess.run(["systemctl", "restart", f"oneport-forward@{name}"], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
